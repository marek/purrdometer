<%# Settings: the wheel and the screen, saved to the web UI's overrides file. -%>
<%@ include "web/settings_view.h" %>
<%@ include "head.page.h" %>
<%@ include "foot.page.h" %>
<%@ param const purr::SettingsView& v %>
<% using namespace purr; using namespace purr::web; -%>
<% const auto& e = v.values; const bool inches = e.units == "in"; -%>
<% head(out, "Settings · purrdometer", v.current.name, v.scanning ? 5 : 0); -%>
<% if (v.saved) { -%>
<section class="ok">Saved. The dashboard uses it now; the screen within a minute.</section>
<% } -%>
<% if (v.wasReset) { -%>
<section class="ok">Back to the defaults in <code>/etc/purrdometer/purrdometer.conf</code>.</section>
<% } -%>
<% for (auto& p : v.problems) { -%>
<section class="error">Not saved: <%= p %></section>
<% } -%>
<% for (auto& p : v.configErrors) { -%>
<section class="error">Config: <%= p %></section>
<% } -%>
<% if (!v.canSave) { -%>
<section>
  <strong>View only.</strong> <%= v.whyNot %>
</section>
<% } -%>

<form method="post" action="/settings">
<input type="hidden" name="token" value="<%= v.token %>">

<section>
  <h2>Wheel <span>· distance is rotations × the running circumference</span></h2>

  <label>Units</label>
  <div class="toggle" role="radiogroup" aria-label="Units">
    <label><input type="radio" name="units" value="cm"<%= inches ? "" : " checked" %>><span>cm</span></label>
    <label><input type="radio" name="units" value="in"<%= inches ? " checked" : "" %>><span>inches</span></label>
  </div>
  <p class="hint">How sizes are shown, and the unit of a measured diameter. Distances are always km.</p>

  <label for="model">Wheel</label>
  <select id="model" name="model">
<% for (auto& w : v.presets->wheels) { -%>
    <option value="<%= w.key %>" data-m="<%= fixed(w.diameterM, 4) %>"<%= w.key == e.model ? " selected" : "" %>><%= w.name %> · <%= showLength(w.diameterM, e.units).substr(0, showLength(w.diameterM, e.units).find(" (")) %><%= w.estimated ? " (estimated)" : "" %></option>
<% } -%>
  </select>

  <label for="diameter">Measured diameter <span class="muted">(optional)</span></label>
  <div class="row">
    <input id="diameter" name="diameter" type="number" step="0.1" min="0" inputmode="decimal"
           value="<%= e.diameter ? *e.diameter : "" %>" placeholder="preset">
    <span id="unit"><%= inches ? "in" : "cm" %></span>
  </div>
  <p class="hint">Inside of the running track, edge to edge. Leave empty to use the wheel's published size.</p>
  <p class="hint">Now: <%= describe(v.current, e.units) %></p>
</section>

<section id="sensor">
  <h2>Sensor <span>· a cadence or speed sensor on the wheel</span></h2>
  <label class="choice"><input type="radio" name="sensor" value=""<%= e.sensor ? "" : " checked" %>> Automatic <span class="muted">· the first sensor heard</span></label>
<% for (auto& s : v.sensors) { const bool inUse = s.address == v.live.sensor; -%>
  <label class="choice"><input type="radio" name="sensor" value="<%= s.address %>"<%= e.sensor && *e.sensor == s.address ? " checked" : "" %>>
    <strong><%= s.name.empty() ? s.address : s.name %></strong>
    <span class="muted">· <%= s.kind.empty() ? "kind not read yet" : s.kind %><% if (s.rssi) { %> · <%= *s.rssi %> dBm<% } %> · heard <%= ago(double(v.now) - s.lastSeen) %> · <%= s.address %></span>
<%   if (inUse) { -%>
    <span class="tag"><%= v.live.connected ? "connected" : "chosen, asleep" %><% if (v.live.battery) { %> · battery <%= *v.live.battery %>%<% } %></span>
<%   } -%>
  </label>
<% } -%>
<% if (v.sensors.empty()) { -%>
  <p class="hint">No sensors heard yet. Turn the sensor to wake it, then scan.</p>
<% } -%>
  <div class="row">
    <button type="submit" class="secondary" formaction="/settings/scan" formnovalidate<%= v.canSave && !v.scanning ? "" : " disabled" %>><%= v.scanning ? "Scanning…" : "Scan for sensors" %></button>
    <span class="hint"><%= v.scanning ? "about 20 s; the list fills in as sensors are heard" : "turn the sensor first: a sleeping sensor is silent" %></span>
  </div>

<% const bool speed = v.live.sensorKind == "speed"; -%>
  <h2>Mounting <span>· <%= speed ? "speed sensor" : "cadence sensor" %></span></h2>
  <div class="mount">
<% if (speed) { -%>
    <svg viewBox="0 0 120 120" width="120" height="120" aria-hidden="true">
      <circle cx="60" cy="60" r="54" fill="none" stroke="currentColor" stroke-width="3"/>
      <circle cx="60" cy="60" r="8" fill="currentColor"/>
      <rect x="66" y="52" width="22" height="16" rx="4" fill="var(--c3)"/>
      <path d="M60 14 A46 46 0 0 1 102 44" fill="none" stroke="var(--muted)" stroke-width="2" marker-end="url(#a)"/>
      <defs><marker id="a" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8 z" fill="var(--muted)"/></marker></defs>
    </svg>
    <div>
      <p>On the axle or hub, as it would sit on a bicycle hub, or on the wheel's face like a cadence sensor. One turn of the wheel is one revolution.</p>
      <p class="hint">Keep the battery door reachable: fix the sensor's holder, not the sensor.</p>
    </div>
<% } else { -%>
    <svg viewBox="0 0 120 120" width="120" height="120" aria-hidden="true">
      <circle cx="60" cy="60" r="54" fill="none" stroke="currentColor" stroke-width="3"/>
      <circle cx="60" cy="60" r="4" fill="currentColor"/>
      <rect x="68" y="38" width="20" height="20" rx="10" fill="var(--c3)"/>
      <path d="M60 14 A46 46 0 0 1 102 44" fill="none" stroke="var(--muted)" stroke-width="2" marker-end="url(#a)"/>
      <defs><marker id="a" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8 z" fill="var(--muted)"/></marker></defs>
    </svg>
    <div>
      <p>On the back face of the wheel, close to the axle (about a crank's length, 15 cm), its face flat against the wheel. It counts turns of its own orientation, like a clock hand going round, so one turn of the wheel is one revolution.</p>
      <p class="hint">Keep the battery door reachable: fix the sensor's holder, not the sensor. Shaking or spinning it in the hand wakes it but does not count.</p>
    </div>
<% } -%>
  </div>

  <h2>Test <span>· nothing is saved</span></h2>
  <div class="row">
    <button type="button" class="secondary" id="test">Start test</button>
    <span id="testout" class="muted">press Start, then turn the wheel</span>
  </div>
</section>

<section>
  <h2>Screen</h2>
  <label><input type="checkbox" name="rotate180" value="1"<%= e.rotate180 ? " checked" : "" %>> Upside down (rotate 180°)</label>
  <label for="active">Seconds between updates while the wheel turns</label>
  <input id="active" name="active_refresh_s" type="number" min="1" max="60" value="<%= e.activeRefreshS %>">
  <label for="idle">Seconds between checks while it does not</label>
  <input id="idle" name="idle_refresh_s" type="number" min="10" max="3600" value="<%= e.idleRefreshS %>">
  <label for="full">Fast updates between full, flashing refreshes</label>
  <input id="full" name="full_refresh_every" type="number" min="1" max="200" value="<%= e.fullRefreshEvery %>">
</section>

<% if (v.access == SettingsAccess::Pin && v.canSave) { -%>
<section>
  <label for="pin">PIN</label>
  <input id="pin" name="pin" type="password" autocomplete="current-password" required>
</section>
<% } -%>

<div class="row">
  <button type="submit"<%= v.canSave ? "" : " disabled" %>>Save</button>
<% if (v.overridden) { -%>
  <button type="submit" class="secondary" formaction="/settings/reset"<%= v.canSave ? "" : " disabled" %>
          formnovalidate>Reset to defaults</button>
<% } -%>
</div>
</form>

<script>
// Switching units converts a typed diameter and relabels the wheel sizes.
(function () {
  var diameter = document.getElementById('diameter'), unit = document.getElementById('unit');
  document.querySelectorAll('input[name=units]').forEach(function (r) {
    r.addEventListener('change', function () {
      var toIn = r.value === 'in', v = parseFloat(diameter.value);
      if (!isNaN(v)) diameter.value = (toIn ? v / 2.54 : v * 2.54).toFixed(1);
      unit.textContent = toIn ? 'in' : 'cm';
      document.querySelectorAll('#model option').forEach(function (o) {
        var m = parseFloat(o.dataset.m), size = toIn ? (m / 0.0254).toFixed(1) + ' in' : (m * 100).toFixed(1) + ' cm';
        o.textContent = o.textContent.replace(/ · [0-9.]+ (cm|in)/, ' · ' + size);
      });
    });
  });
})();
// The live test: rotations and rpm since Start, from the same JSON as the dashboard.
(function () {
  var button = document.getElementById('test'), out = document.getElementById('testout'), timer = null, base = 0, until = 0;
  function stats() { return fetch('/api/stats', {cache: 'no-store'}).then(function (r) { return r.json(); }); }
  function stop() { clearInterval(timer); timer = null; button.textContent = 'Start test'; }
  button.addEventListener('click', function () {
    if (timer) return stop();
    stats().then(function (s) {
      base = s.total.rotations; until = Date.now() + 120000; button.textContent = 'Stop';
      out.textContent = s.live.connected ? 'turn the wheel now' : 'the sensor is not connected: turn it to wake it';
      timer = setInterval(function () {
        if (Date.now() > until) return stop();
        stats().then(function (s) {
          var n = s.total.rotations - base;
          out.textContent = !s.live.connected ? 'the sensor is not connected: turn it to wake it'
            : n + (n === 1 ? ' rotation' : ' rotations') + ' · ' + s.live.rpm + ' rpm';
        });
      }, 1000);
    });
  });
})();
</script>
<% foot(out, "Saved to <code>/var/lib/purrdometer/settings.ini</code>, over <code>/etc/purrdometer/purrdometer.conf</code>. "
        "Who may save is <code>[web] settings_access</code> in that file: <strong>" + std::string(accessName(v.access)) + "</strong>."); -%>
