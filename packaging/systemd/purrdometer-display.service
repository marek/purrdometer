[Unit]
Description=purrdometer e-paper display
After=purrdometer-logger.service

[Service]
User=purrdometer
Group=purrdometer
SupplementaryGroups=spi i2c gpio
StateDirectory=purrdometer
ExecStart=/usr/bin/purrdometer-display
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
