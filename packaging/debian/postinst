#!/bin/sh
set -e

MAIN_CONF=/etc/bluetooth/main.conf
BLUEZ_STATE=/var/lib/bluetooth
DOC="see /usr/share/doc/purrdometer/README.md"

# Makes [section] of main.conf hold the one active "key = value", right under a
# "# purrdometer:" marker line, whatever it holds now: a changed value, a
# missing one, a duplicate, a marker with no setting. Other settings of the key
# in that section are replaced; the rest of the file is kept. Returns 0 when
# the file changed, 1 when it already was so, 2 when it could not be written.
bluez_setting() { # section key value why
    marker="# purrdometer: $4 ($DOC)"
    rewritten=$(mktemp "$MAIN_CONF.XXXXXX") || return 2
    if awk -v sec="$1" -v key="$2" -v val="$3" -v marker="$marker" '
        /^[ \t]*\[[^]]*\][ \t]*$/ {
            cur = $0; gsub(/^[ \t]*\[|\][ \t]*$/, "", cur)
            print
            if (cur == sec && !done) { print marker; print key " = " val; done = 1 }
            next
        }
        $0 == marker { next }
        cur == sec && $0 ~ ("^[ \t]*" key "[ \t]*=") { next }
        { print }
        END { if (!done) { print ""; print "[" sec "]"; print marker; print key " = " val } }
    ' "$MAIN_CONF" > "$rewritten" && chmod --reference="$MAIN_CONF" "$rewritten"; then
        if cmp -s "$rewritten" "$MAIN_CONF"; then
            rm -f "$rewritten"
            return 1
        fi
        mv "$rewritten" "$MAIN_CONF" || { rm -f "$rewritten"; return 2; }
        return 0
    fi
    rm -f "$rewritten"
    return 2
}

# True when [section] holds the key once, with the value.
bluez_has() { # section key value
    awk -v sec="$1" -v key="$2" -v val="$3" '
        /^[ \t]*\[[^]]*\][ \t]*$/ { cur = $0; gsub(/^[ \t]*\[|\][ \t]*$/, "", cur); next }
        cur == sec && $0 ~ ("^[ \t]*" key "[ \t]*=") {
            n++; v = $0; sub(/^[^=]*=[ \t]*/, "", v); sub(/[ \t]*$/, "", v); if (v == val) ok++
        }
        END { exit !(n == 1 && ok == 1) }
    ' "$MAIN_CONF"
}

# Sets one BlueZ setting and proves it took; stops the install when it did not.
set_bluez() { # section key value why
    rc=0
    bluez_setting "$@" || rc=$?
    if [ "$rc" -ge 2 ] || ! bluez_has "$1" "$2" "$3"; then
        echo "purrdometer: cannot set $2 = $3 in [$1] of $MAIN_CONF" >&2
        exit 1
    fi
    [ "$rc" -eq 0 ] && changed=1
    return 0
}

configure_bluez() {
    [ -f "$MAIN_CONF" ] || return 0
    changed=
    set_bluez LE ConnectionSupervisionTimeout 600 "6 s LE supervision timeout"
    # A random address for every connection: a sensor that kept a pairing with
    # this Pi's own address sends it nothing over an unencrypted link.
    set_bluez General Privacy device "connect with a random address"
    [ -n "$changed" ] || return 0
    # BlueZ caches per-device connection parameters; they override the default.
    systemctl stop bluetooth.service 2>/dev/null || true
    for info in "$BLUEZ_STATE"/*/*/info; do
        [ -f "$info" ] || continue
        sed -i '/^\[ConnectionParameters\]/,/^\[/{/^\[ConnectionParameters\]/d;/^\[/!d}' "$info"
    done
    systemctl start bluetooth.service 2>/dev/null || true
}

# Bluetooth must not be soft-blocked; systemd-rfkill keeps this across reboots.
unblock_bluetooth() {
    for r in /sys/class/rfkill/rfkill*; do
        [ -f "$r/type" ] && [ "$(cat "$r/type")" = bluetooth ] && echo 0 > "$r/soft" 2>/dev/null || true
    done
}

# In a chroot (building an image) there is no running system to change:
# the setting files are written, and the first boot does the rest.
in_chroot() { systemd-detect-virt --chroot >/dev/null 2>&1; }

if [ "$1" = configure ]; then
    if ! getent passwd purrdometer >/dev/null; then
        adduser --system --group --home /var/lib/purrdometer \
            --gecos "purrdometer" purrdometer >/dev/null
    fi
    install -d -o purrdometer -g purrdometer -m 0755 /var/lib/purrdometer
    configure_bluez
    in_chroot || unblock_bluetooth
    # NetworkManager applies the powersave conf on the next connection; apply it now too.
    if ! in_chroot; then
        if command -v iwconfig >/dev/null 2>&1; then iwconfig wlan0 power off 2>/dev/null || true
        elif [ -x /usr/sbin/iwconfig ]; then /usr/sbin/iwconfig wlan0 power off 2>/dev/null || true; fi
    fi
    systemctl enable purrdometer-logger.service purrdometer-display.service purrdometer-web.service \
        purrdometer-setup.service >/dev/null 2>&1
    if ! in_chroot; then
        systemctl daemon-reload
        systemctl restart purrdometer-logger.service purrdometer-display.service purrdometer-web.service \
            purrdometer-setup.service || true
    fi
fi
exit 0
