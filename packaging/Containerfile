# Build environment matching the Pi: Debian trixie, arm64.
# Used by packaging/build-in-container.sh; the Pi itself needs none of this.
FROM docker.io/library/debian:trixie
COPY build-deps /tmp/build-deps
RUN apt-get update && grep -v '^#' /tmp/build-deps | xargs env DEBIAN_FRONTEND=noninteractive \
        apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
# The checkout is mounted from the host, owned by another user.
RUN git config --system --add safe.directory '*'
WORKDIR /src
